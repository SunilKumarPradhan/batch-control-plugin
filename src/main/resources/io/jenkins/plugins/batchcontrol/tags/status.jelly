<?jelly escape-by-default='true'?>
<!-- #18.2 (Wave D, D2): a status or cause shown as a readable label (ui.StatusLabels, reached
     through the root action: j:invokeStatic cannot see plugin classes in a real Jenkins). The
     element keeps the enum name in data-batch-control-status, the stable hook for tests and
     scripts; CSV exports, filters and the JSON summary keep the enum names. Nothing is rendered
     for a null value. Escaped by default. -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
  <st:documentation>
    A readable status or cause label carrying the enum name.
    <st:attribute name="value" use="required">The enum constant (RequestStatus, IncidentStatus or CauseType).</st:attribute>
    <st:attribute name="label">The text to show instead of the default label (a page's own wording for this status).</st:attribute>
    <st:attribute name="runRequest">"true" for a run request's status: APPROVED reads "Approved, waiting to run".</st:attribute>
  </st:documentation>
  <j:if test="${attrs.value != null}">
    <j:set var="bcStatusRoot" value="${app.getExtensionList('io.jenkins.plugins.batchcontrol.action.BatchControlRootAction').get(0)}"/>
    <span data-batch-control-status="${attrs.value}">${attrs.label != null ? attrs.label : bcStatusRoot.statusLabel(attrs.value, attrs.runRequest == 'true')}</span>
  </j:if>
</j:jelly>
