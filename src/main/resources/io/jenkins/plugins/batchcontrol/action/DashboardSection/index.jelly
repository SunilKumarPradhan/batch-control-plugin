<?jelly escape-by-default='true'?>
<j:jelly xmlns:bc="/io/jenkins/plugins/batchcontrol/tags" xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="Run Dashboard" type="one-column" permissions="${it.viewPermissions}">
    <l:main-panel>
      <l:app-bar title="Run Dashboard"/>
      <bc:tabs active="dashboard"/>
      <!-- D-67: at most the 50 most recent runs; History lists the rest (filters, paging, CSV). -->
      <p class="jenkins-description">
        The ${it.limit} most recent builds of every job with cause, user, parameters, result and
        duration, newest first. Secret parameter values are stored masked, and file parameters
        only by their file name.
      </p>

      <j:set var="links" value="${it.links}"/>
      <j:set var="requestLinks" value="${links.requests}"/>
      <!-- security-11 N-02: lines over 1 MiB are skipped on every read path, CSV included. -->
      <j:if test="${it.oversized > 0}">
        <div class="jenkins-alert jenkins-alert-warning" style="margin-bottom: 1rem;">
          ${it.oversized} over-long record(s) (larger than 1 MiB) were skipped while reading the
          newest records and are not listed here. The CSV export skips them too; the controller log names
          the file that holds them.
        </div>
      </j:if>
      <j:set var="items" value="${it.items}"/>
      <j:choose>
        <j:when test="${empty(items)}">
          <p>No runs recorded.</p>
        </j:when>
        <j:otherwise>
          <!-- #6, #18.1 (Wave D, D3): seven columns. The Run cell holds the status icon, the job,
               the #n run and the result label (tags/runCell.jelly, linked per D-44) and says who
               aborted the run; the Parameters cell shows three lines and folds the rest
               (tags/parameters.jelly). Cause, User, Started and Duration do not wrap. -->
          <table class="jenkins-table jenkins-table--small jenkins-!-margin-bottom-0">
            <thead>
              <tr>
                <th>Run</th>
                <th>Cause</th>
                <th>User</th>
                <th>Parameters</th>
                <th>Started</th>
                <th>Duration</th>
                <th class="batch-control-nowrap">Request id</th>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="r" items="${items}">
                <tr>
                  <td><bc:runCell record="${r}"/></td>
                  <td class="batch-control-nowrap"><bc:status value="${r.causeType}"/></td>
                  <td class="batch-control-nowrap">${r.user}</td>
                  <td><bc:parameters value="${r.parameters}"/></td>
                  <td class="batch-control-nowrap">${it.format(r.startedAt)}</td>
                  <td class="batch-control-nowrap">${it.duration(r.durationMs)}</td>
                  <td>
                    <!-- Linked only for a user who may open this request (SPEC item 2, DEF-11). -->
                    <j:choose>
                      <j:when test="${r.runRequestId != null and requestLinks and links.request(r.runRequestId)}">
                        <bc:idLink href="${rootURL}/batch-control/requests/${r.runRequestId}/" value="${r.runRequestId}"/>
                      </j:when>
                      <j:otherwise><bc:idLink value="${r.runRequestId}"/></j:otherwise>
                    </j:choose>
                  </td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
          <p class="jenkins-!-margin-top-1" data-batch-control-history-link="true">
            Older runs, filters and the CSV export are on the
            <a href="${rootURL}/batch-control/history/">History</a> tab.
          </p>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
</j:jelly>
